    {
      "name": "Categoria",
      "item": [
        {
          "name": "Crear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{categoriaUrl}}/api/categorias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lab11 Postman categoria\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Comenzar siempre una ejecución limpia de IDs; no se reutilizan IDs de otra ejecución.",
                  "['categoria','cliente','producto','pedido'].forEach(s => { pm.collectionVariables.unset(s+'Id'); pm.variables.unset(s+'Id'); });",
                  "pm.collectionVariables.set('lab11Run',Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code === 201) pm.collectionVariables.set(\"categoriaId\",pm.response.json().id);",
                  "pm.test('ID generado', () => { if(pm.response.code===201) pm.expect(pm.response.json().id).to.be.above(0); });",
                  "if(pm.response.code===201) pm.variables.set('categoriaId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{categoriaUrl}}/api/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Lista JSON', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener creado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{categoriaUrl}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const necesarios=[\"categoriaId\"];",
                  "if(necesarios.some(k => !pm.collectionVariables.get(k))) { console.warn('Solicitud omitida: ejecutar primero las creaciones correctas de la colección.'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar creado",
          "request": {
            "method": "PUT",
