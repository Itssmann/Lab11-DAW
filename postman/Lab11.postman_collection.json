    {
      "key": "categoriaUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "categoriaId",
      "value": ""
    },
    {
      "key": "clienteUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "productoUrl",
      "value": "http://localhost:8083"
    },
